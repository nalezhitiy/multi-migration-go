# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=dev_postgres_password
APP_POSTGRES_DSN=postgres://app:dev_postgres_password@postgresql:5432/app?sslmode=disable

# MariaDB
MARIADB_DATABASE=app
MARIADB_USER=app
MARIADB_PASSWORD=dev_mariadb_password
MARIADB_ROOT_PASSWORD=dev_mariadb_root_password
APP_MARIADB_DSN=app:dev_mariadb_password@tcp(mariadb:3306)/app?parseTime=true

# ClickHouse
CLICKHOUSE_DB=app
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=dev_clickhouse_password
APP_CLICKHOUSE_DSN=clickhouse://app:dev_clickhouse_password@clickhouse:9000/app?dial_timeout=10s